FIREFLY_III_URL=
FIREFLY_III_ACCESS_TOKEN=
# Self-signed / private CA: path to the CA file (PEM). `false` disables verification.
# FIREFLY_III_VERIFY_SSL=true
# Bearer token MCP clients must send (32+ chars, e.g. `openssl rand -hex 32`). Strongly recommended.
MCP_AUTH_TOKEN=

# --- OAuth mode (instead of FIREFLY_III_ACCESS_TOKEN and MCP_AUTH_TOKEN) ---
# FIREFLY_III_OAUTH_CLIENT_ID=
# FIREFLY_III_OAUTH_CLIENT_SECRET=
# MCP_BASE_URL=http://localhost:8000
# Required when MCP_BASE_URL is not localhost:
# FIREFLY_III_OAUTH_JWT_SIGNING_KEY=
# FIREFLY_III_OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,http://localhost:*
# Optional, to share sign-ins across workers (needs the storage key):
# FIREFLY_III_OAUTH_REDIS_URL=redis://redis:6379/0
# FIREFLY_III_OAUTH_STORAGE_ENCRYPTION_KEY=
# FIREFLY_III_OAUTH_VALIDATION_TTL=60
# FIREFLY_III_OAUTH_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
